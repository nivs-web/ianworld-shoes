# Firebase 웹 앱 설정 — 이 파일을 .env 로 복사한 뒤 실제 값을 채운다.
# .env 는 절대 커밋하지 않는다. Vercel > Settings > Environment Variables 에도 동일하게 등록한다.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 멀티플레이용 Realtime Database URL
VITE_FIREBASE_DATABASE_URL=

# 개발 편의 플래그 (1이면 디버그 오버레이 표시)
VITE_DEBUG=0

# 로그인 핸들러를 우리 도메인에서 직접 받기. 기본은 켜짐(비워두면 켜짐).
# 새 도메인을 붙일 때는 먼저: ① Firebase 승인된 도메인 추가
#   ② Google Cloud OAuth 클라이언트의 승인된 리디렉션 URI에
#      https://<새도메인>/__/auth/handler 추가  ③ vercel.json 프록시 확인
# 안 하고 배포하면 그 도메인에서 로그인이 막힌다. 급히 되돌리려면 0.
VITE_FIREBASE_SELF_AUTH=1
