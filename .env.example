# Firebase 웹 앱 설정 — 이 파일을 .env 로 복사한 뒤 실제 값을 채운다.
# .env 는 절대 커밋하지 않는다. Vercel > Settings > Environment Variables 에도 동일하게 등록한다.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 멀티플레이용 Realtime Database URL
VITE_FIREBASE_DATABASE_URL=

# 개발 편의 플래그 (1이면 디버그 오버레이 표시)
VITE_DEBUG=0

# 로그인 핸들러를 우리 도메인에서 직접 받기 (1=켬).
# 켜기 전에 반드시: ① Firebase 승인된 도메인에 배포 호스트 추가
#                  ② Google Cloud OAuth 클라이언트의 승인된 리디렉션 URI에
#                     https://<배포호스트>/__/auth/handler 추가
# 안 하면 로그인이 아예 막힌다. 자세한 이유는 src/services/firebase.js 주석 참고.
VITE_FIREBASE_SELF_AUTH=0
