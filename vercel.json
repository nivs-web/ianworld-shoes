{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://find-shoes-f5c55.firebaseapp.com/__/auth/:path*" },
    { "source": "/((?!assets/|icons/|dragon/|manifest.webmanifest|sw.js|__/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/((?!characters/|shoes/|bg/|ui/).*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(characters|shoes|bg|ui)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
